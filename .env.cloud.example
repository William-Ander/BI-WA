# BI WA Cloud — exemplo de configuração
# Copie para .env, ajuste as variáveis e execute:
#   scripts/deploy-cloud.sh          (Linux)
#   scripts\deploy-cloud.ps1         (Windows)

# Modo de operação (sempre "online" para cloud)
APP_MODE=online
PORT=3000

# ==========================================
# Credenciais
# ==========================================
VIEWER_USER=viewer
VIEWER_PASSWORD=TroqueAqui
BIWA_AUTH_SECRET=                            # Gerado automaticamente se vazio
SYNC_TOKEN=                                  # Gerado automaticamente se vazio

# ==========================================
# MySQL (docker-compose.cloud.yml já inclui MySQL)
# ==========================================
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=biwa
MYSQL_PASSWORD=TroqueSenhaBiwa
MYSQL_DATABASE=biwa_cloud
MYSQL_SSL=false
DB_CONNECTION_LIMIT=10

# ==========================================
# Refresh e tempo real
# ==========================================
DEFAULT_REFRESH_SECONDS=15
SERVER_PUSH_INTERVAL_SECONDS=15
BIWA_QUERY_CACHE_ENABLED=true
BIWA_QUERY_CACHE_TTL_MS=15000

# Tabela de controle para invalidação de cache em tempo real
# BIWA_REALTIME_EVENT_TABLE=controle_atualizacao
# BIWA_REALTIME_EVENT_COLUMN=updated_at
# BIWA_REALTIME_EVENT_POLL_SECONDS=5

# ==========================================
# Cache PostgreSQL (opcional)
# ==========================================
# BIWA_PG_CACHE_ENABLED=false
# BIWA_PG_CACHE_HOST=
# BIWA_PG_CACHE_PORT=5432
# BIWA_PG_CACHE_DATABASE=bi_wa_cache
# BIWA_PG_CACHE_USER=biwa_cache
# BIWA_PG_CACHE_PASSWORD=

# ==========================================
# Segurança
# ==========================================
BIWA_ALLOW_OPEN_ONLINE=false

# ==========================================
# MySQL Root (para o container MySQL)
# ==========================================
MYSQL_ROOT_PASSWORD=TroqueSenhaRoot

# ==========================================
# Portas (opcional)
# ==========================================
# APP_PORT=3000
# HTTP_PORT=80
# HTTPS_PORT=443
