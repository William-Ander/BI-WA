# BI WA - exemplo de configuracao local. Copie para .env e preencha no computador de uso.
# Nunca envie .env real em ZIP, email ou repositorio.

PORT=3000
APP_MODE=desktop

APP_USER=admin
APP_PASSWORD=TROQUE_ANTES_DE_USAR
VIEWER_USER=viewer
VIEWER_PASSWORD=TROQUE_ANTES_DE_USAR
BIWA_AUTH_SECRET=TROQUE_POR_UM_SEGREDO_GRANDE

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=usuario_bi
MYSQL_PASSWORD=TROQUE_ANTES_DE_USAR
MYSQL_DATABASE=nome_do_banco
MYSQL_SSL=false
DB_CONNECTION_LIMIT=10

DEFAULT_REFRESH_SECONDS=15
SERVER_PUSH_INTERVAL_SECONDS=15
BIWA_DATA_SOURCE_HEALTH_INTERVAL_MS=5000
BIWA_DATA_SOURCE_HEALTH_TIMEOUT_MS=2500
BIWA_TIME_ZONE=America/Bahia
BIWA_QUERY_CACHE_ENABLED=true
BIWA_QUERY_CACHE_TTL_MS=15000
# BIWA_REALTIME_EVENT_TABLE=nome_da_tabela_de_controle
# BIWA_REALTIME_EVENT_COLUMN=updated_at
# BIWA_REALTIME_EVENT_POLL_SECONDS=5

# Cache PostgreSQL do BI WA (opcional)
# Execute instalar_postgresql_cache_bi_wa.bat para instalar/configurar no Windows.
BIWA_PG_CACHE_ENABLED=true
BIWA_PG_CACHE_HOST=127.0.0.1
BIWA_PG_CACHE_PORT=5432
BIWA_PG_CACHE_DATABASE=bi_wa_cache
BIWA_PG_CACHE_USER=biwa_cache
BIWA_PG_CACHE_PASSWORD=biwa_cache
BIWA_PG_CACHE_SCHEMA=biwa_cache
BIWA_PG_CACHE_BATCH_SIZE=5000
BIWA_PG_CACHE_MAX_ROWS=200000
# Intervalo de sincronizacao periodica do cache PostgreSQL (ms). 300000 = 5 minutos.
BIWA_PG_SYNC_INTERVAL_MS=300000
