# BI WA - Online/Viewer
# Use este modelo somente no servidor/nuvem da versao online.
APP_MODE=online
PORT=3000

# Login do visualizador online. Para producao, use senha forte ou cadastre usuarios pelo Admin.
VIEWER_USER=viewer
VIEWER_PASSWORD=
BIWA_AUTH_SECRET=troque-por-uma-chave-grande-e-secreta
BIWA_ONLINE_USERS_JSON=[]
BIWA_ONLINE_USERS_BASE64=

# Token usado pelo Desktop/Admin para publicar relatorios para esta versao online.
SYNC_TOKEN=

# MySQL da versao online. Recomenda-se usuario somente leitura.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=bi_viewer
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_SSL=false
DB_CONNECTION_LIMIT=10

# PostgreSQL e atualizacao autonoma no servidor.
BIWA_PG_CACHE_ENABLED=true
BIWA_PG_CACHE_HOST=127.0.0.1
BIWA_PG_CACHE_PORT=5432
BIWA_PG_CACHE_DATABASE=bi_wa_cache
BIWA_PG_CACHE_USER=biwa_cache
BIWA_PG_CACHE_PASSWORD=
BIWA_PG_CACHE_SYNC_OWNER=server
BIWA_PG_CACHE_STARTUP_SYNC=true
BIWA_PG_CACHE_AUTO_CREATE_MISSING=true
BIWA_PG_CACHE_SYNC_INTERVAL_MINUTES=5
BIWA_PG_CACHE_RECENT_WINDOW_DAYS=60

# Bloqueios obrigatorios da versao online.
ALLOW_TABLE_WRITES=false
ALLOW_SCHEMA_CHANGES=false
ALLOW_REPORT_EDITING=false
ALLOW_PUBLISH=false

# Atualizacao automatica dos dashboards.
DEFAULT_REFRESH_SECONDS=15
SERVER_PUSH_INTERVAL_SECONDS=15
BIWA_DATA_SOURCE_HEALTH_INTERVAL_MS=5000
BIWA_DATA_SOURCE_HEALTH_TIMEOUT_MS=2500
BIWA_TIME_ZONE=America/Bahia
CORS_ORIGIN=

# Performance / tempo real inteligente.
BIWA_QUERY_CACHE_ENABLED=true
BIWA_QUERY_CACHE_TTL_MS=15000
BIWA_QUERY_CACHE_MAX_ITEMS=250
BIWA_REALTIME_EVENT_TABLE=
BIWA_REALTIME_EVENT_COLUMN=updated_at
BIWA_REALTIME_EVENT_POLL_SECONDS=5
